import CWFlow.Interp.BallHamilton
import CWFlow.Extension.JetTime
import Mathlib.Analysis.Calculus.FDeriv.Symmetric
import Mathlib.GroupTheory.Perm.Sign
import Mathlib.GroupTheory.Perm.Fin

/-!
# Symmetry of coordinate jets

For `ξ` smooth the coordinate jets `jet m ξ x I` are invariant under permutations of the index tuple `I`
(`jet_comp_perm`): the mixed partial derivatives commute. The proof is by induction on `m`, using that
`Sym (Fin (m+1))` is generated by adjacent transpositions: those not involving the first slot are handled
by the induction hypothesis applied to `jet m ξ`, and the first transposition is the symmetry of second
derivatives (`jet_swap_first`).
-/

set_option linter.unusedSectionVars false

open scoped ContDiff
open CWFlow.Interp

namespace CWFlow.Extension

variable {n : ℕ} {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V] [FiniteDimensional ℝ V]

local notation "E" => EuclideanSpace ℝ (Fin n)

/-- One partial derivative of a coordinate of the jet. -/
theorem jet_cons_eq_fderiv {ξ : E → V} (hξ : ContDiff ℝ ∞ ξ) (m : ℕ) (x : E) (a : Fin n)
    (J : Fin m → Fin n) :
    jet (m + 1) ξ x (Fin.cons a J) =
      fderiv ℝ (fun y => jet m ξ y J) x (EuclideanSpace.single a 1) := by
  rw [← fderiv_jet_apply hξ m x a J,
    fderiv_piLp_apply ((contDiff_jet hξ m).differentiable (by simp) x)]

/-- The first two indices can be swapped. -/
theorem jet_swap_first {ξ : E → V} (hξ : ContDiff ℝ ∞ ξ) (m : ℕ)
    (x : E) (a b : Fin n) (I : Fin m → Fin n) :
    jet (m + 2) ξ x (Fin.cons a (Fin.cons b I)) = jet (m + 2) ξ x (Fin.cons b (Fin.cons a I)) := by
  set F : E → V := fun z => jet m ξ z I with hF
  have hFs : ContDiff ℝ ∞ F := by
    have := (PiLp.proj (𝕜 := ℝ) 2 (fun _ : Fin m → Fin n => V) I).contDiff.comp (contDiff_jet hξ m)
    exact this
  have key : ∀ a b : Fin n, jet (m + 2) ξ x (Fin.cons a (Fin.cons b I)) =
      fderiv ℝ (fderiv ℝ F) x (EuclideanSpace.single a 1) (EuclideanSpace.single b 1) := by
    intro a b
    have h1 : jet (m + 2) ξ x (Fin.cons a (Fin.cons b I)) =
        fderiv ℝ (fun y => jet (m + 1) ξ y (Fin.cons b I)) x (EuclideanSpace.single a 1) :=
      jet_cons_eq_fderiv hξ (m + 1) x a _
    have h2 : (fun y => jet (m + 1) ξ y (Fin.cons b I)) =
        fun y => fderiv ℝ F y (EuclideanSpace.single b 1) := by
      funext y; exact jet_cons_eq_fderiv hξ m y b I
    rw [h1, h2]
    have hd : DifferentiableAt ℝ (fderiv ℝ F) x :=
      (hFs.fderiv_right (m := ∞) (by simp)).differentiable (by simp) x
    have := fderiv_clm_apply hd (differentiableAt_const (EuclideanSpace.single b (1 : ℝ) : E))
    rw [this]
    simp
  have hs : IsSymmSndFDerivAt ℝ F x :=
    hFs.contDiffAt.isSymmSndFDerivAt (n := ∞) (by simp; exact WithTop.coe_le_coe.2 le_top)
  rw [key a b, key b a, hs]

/-- Reading off the tail of a permutation fixing `0`. -/
private theorem jet_swap_succ {ξ : E → V} (m : ℕ) (x : E)
    (ih : ∀ (x : E) (σ : Equiv.Perm (Fin (m + 1))) (I : Fin (m + 1) → Fin n),
      jet (m + 1) ξ x (I ∘ σ) = jet (m + 1) ξ x I)
    (hξ : ContDiff ℝ ∞ ξ) (j : Fin m) (I : Fin (m + 2) → Fin n) :
    jet (m + 2) ξ x (I ∘ Equiv.swap j.succ.castSucc j.succ.succ) = jet (m + 2) ξ x I := by
  obtain ⟨a, J, rfl⟩ : ∃ (a : Fin n) (J : Fin (m + 1) → Fin n), I = Fin.cons a J :=
    ⟨I 0, Fin.tail I, (Fin.cons_self_tail I).symm⟩
  have hc : (Fin.cons a J : Fin (m + 2) → Fin n) ∘ Equiv.swap j.succ.castSucc j.succ.succ =
      Fin.cons a (J ∘ Equiv.swap j.castSucc j.succ) := by
    funext k
    refine Fin.cases ?_ (fun k => ?_) k
    · have h0 : (0 : Fin (m + 2)) ≠ j.succ.castSucc := by
        intro h
        have := congrArg Fin.val h
        simp at this
      have h1 : (0 : Fin (m + 2)) ≠ j.succ.succ := (Fin.succ_ne_zero _).symm
      simp only [Function.comp_apply]
      rw [Equiv.swap_apply_of_ne_of_ne h0 h1]; simp
    · have e : j.succ.castSucc = (j.castSucc).succ := (Fin.succ_castSucc j).symm
      rw [e]
      simp only [Function.comp_apply, Fin.cons_succ]
      congr 1
      rw [Equiv.swap_apply_def, Equiv.swap_apply_def]
      by_cases h1 : k = j.castSucc
      · simp [h1]
      · by_cases h2 : k = j.succ
        · have hne : j.succ ≠ j.castSucc := Fin.castSucc_lt_succ.ne'
          simp [h2, hne]
        · have h1' : k.succ ≠ j.castSucc.succ := fun h => h1 (Fin.succ_injective _ h)
          have h2' : k.succ ≠ j.succ.succ := fun h => h2 (Fin.succ_injective _ h)
          simp [h1, h2, h1', h2']
  rw [hc, jet_cons_eq_fderiv hξ (m + 1) x, jet_cons_eq_fderiv hξ (m + 1) x]
  congr 2
  funext y
  exact ih y _ J

/-- Jets are symmetric: invariant under any permutation of the indices. -/
theorem jet_comp_perm {ξ : E → V} (hξ : ContDiff ℝ ∞ ξ) (m : ℕ)
    (x : E) (σ : Equiv.Perm (Fin m)) (I : Fin m → Fin n) :
    jet m ξ x (I ∘ σ) = jet m ξ x I := by
  induction m generalizing x with
  | zero =>
    have h : I ∘ σ = I := Subsingleton.elim (α := Fin 0 → Fin n) _ _
    rw [h]
  | succ m ih =>
    have hmem : σ ∈ Submonoid.closure (Set.range fun i : Fin m => Equiv.swap i.castSucc i.succ) := by
      rw [Equiv.Perm.mclosure_swap_castSucc_succ]; trivial
    revert I
    refine Submonoid.closure_induction (motive := fun (σ : Equiv.Perm (Fin (m + 1))) _ => ∀ I : Fin (m + 1) → Fin n,
      jet (m + 1) ξ x (I ∘ σ) = jet (m + 1) ξ x I) ?_ ?_ ?_ hmem
    · rintro _ ⟨i, rfl⟩ I
      obtain ⟨m', rfl⟩ : ∃ m', m = m' + 1 := ⟨m - 1, by have := i.pos; omega⟩
      induction i using Fin.cases with
      | zero =>
        obtain ⟨a, b, I', rfl⟩ : ∃ (a b : Fin n) (I' : Fin m' → Fin n), I = Fin.cons a (Fin.cons b I') :=
          ⟨I 0, I 1, fun k => I k.succ.succ, by
            funext k
            refine Fin.cases ?_ (fun k => ?_) k
            · simp
            · refine Fin.cases ?_ (fun k => ?_) k <;> simp⟩
        have hc : (Fin.cons a (Fin.cons b I') : Fin (m' + 2) → Fin n) ∘
            Equiv.swap (Fin.castSucc (0 : Fin (m' + 1))) (Fin.succ (0 : Fin (m' + 1))) =
            Fin.cons b (Fin.cons a I') := by
          funext k
          refine Fin.cases ?_ (fun k => ?_) k
          · simp
          · refine Fin.cases ?_ (fun k => ?_) k
            · simp
            · have h0 : k.succ.succ ≠ Fin.castSucc (0 : Fin (m' + 1)) := by
                intro h
                have := congrArg Fin.val h
                simp at this
              have h1 : k.succ.succ ≠ Fin.succ (0 : Fin (m' + 1)) := by
                intro h
                have := Fin.succ_injective _ h
                exact Fin.succ_ne_zero _ this
              simp only [Function.comp_apply]
              rw [Equiv.swap_apply_of_ne_of_ne h0 h1]; simp
        beta_reduce
        rw [hc, jet_swap_first hξ m' x a b I']
      | succ j =>
        exact jet_swap_succ m' x ih hξ j I
    · intro I; simp
    · intro σ τ _ _ hσ hτ I
      have : I ∘ ⇑(σ * τ) = (I ∘ σ) ∘ τ := rfl
      rw [this, hτ, hσ]

/-- info: 'CWFlow.Extension.jet_swap_first' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs in #print axioms jet_swap_first

/-- info: 'CWFlow.Extension.jet_comp_perm' depends on axioms: [propext, Classical.choice, Quot.sound] -/
#guard_msgs in #print axioms jet_comp_perm

end CWFlow.Extension
